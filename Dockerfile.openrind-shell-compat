# Openrind Shell compatibility sandbox: scoped sync with optional PGlite.

FROM ghcr.io/nvidia/openshell-community/sandboxes/base:latest

USER root

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl gnupg \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

COPY openeral-js/ /opt/openrind-shell/
RUN cd /opt/openrind-shell && npm install && npm run build && npm prune --omit=dev \
    && chmod -R a+rX /opt/openrind-shell \
    && chown -R sandbox:sandbox /opt/openrind-shell \
    && ln -s /opt/openrind-shell /opt/openeral

RUN test -x /usr/local/bin/claude \
    && mv /usr/local/bin/claude /usr/local/bin/claude-real

COPY --chown=sandbox:sandbox sandboxes/openeral/openeral-bash.mjs /opt/openrind-shell/openrind-shell-bash.mjs
RUN chmod a+rx /opt/openrind-shell/openrind-shell-bash.mjs \
    && ln -sf /opt/openrind-shell/openrind-shell-bash.mjs /opt/openrind-shell/openeral-bash.mjs \
    && ln -sf /opt/openrind-shell/openrind-shell-bash.mjs /usr/local/bin/openrind-shell-bash \
    && ln -sf /usr/local/bin/openrind-shell-bash /usr/local/bin/openeral-bash

COPY sandboxes/openeral/openeral-claude.sh /usr/local/bin/claude
COPY sandboxes/openeral/openeral-daemon-ensure.sh /usr/local/bin/openrind-shell-daemon-ensure
COPY sandboxes/openeral/pg-client.mjs /usr/local/bin/pg
RUN chmod 755 /usr/local/bin/claude /usr/local/bin/openrind-shell-daemon-ensure /usr/local/bin/pg \
    && ln -sf /usr/local/bin/openrind-shell-daemon-ensure /usr/local/bin/openeral-daemon-ensure

RUN cp /bin/bash /bin/bash.real

COPY sandboxes/openeral/setup.sh /opt/openrind-shell/setup.sh
RUN chmod 755 /opt/openrind-shell/setup.sh \
    && chown sandbox:sandbox /opt/openrind-shell/setup.sh \
    && ln -sf /opt/openrind-shell/setup.sh /usr/local/bin/openrind-shell \
    && ln -sf /opt/openrind-shell/setup.sh /usr/local/bin/openrind-shell-init \
    && ln -sf /opt/openrind-shell/setup.sh /usr/local/bin/openrind-shell-start \
    && ln -sf /usr/local/bin/openrind-shell /usr/local/bin/openeral \
    && ln -sf /usr/local/bin/openrind-shell-init /usr/local/bin/openeral-init \
    && ln -sf /usr/local/bin/openrind-shell-start /usr/local/bin/openeral-start

COPY sandboxes/openeral/policy.yaml /etc/openshell/policy.yaml
RUN sed -i \
      -e '/^    - \/var\/lib\/openrind-shell\/runtime$/d' \
      -e '/^    - \/var\/lib\/openeral\/runtime$/d' \
      -e '/^fuse_mounts:/,/^# --- Network policies/ { /^# --- Network policies/!d; }' \
      -e '/path: \/usr\/local\/bin\/openrind-shell-fused/d' \
      -e 's#/sandbox/work/#/sandbox/#g' \
      /etc/openshell/policy.yaml
COPY --chown=sandbox:sandbox .claude/skills/ /sandbox/.skills/
